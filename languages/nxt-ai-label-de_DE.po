msgid "Size"
msgstr "Größe"

#: inc/class-admin.php:88
msgid "Save automatic labeling"
msgstr "Automatik speichern"

#: inc/class-admin.php:93
msgid "Scan existing images for AI origin"
msgstr "Bestehende Bilder auf KI-Herkunft prüfen"

#: inc/class-admin.php:95
msgid "Checks only images with no decision yet and writes the label using the settings above. WP-CLI: wp nxt-ai-label detect"
msgstr "Prüft nur Bilder ohne gesetzte Entscheidung und schreibt die Kennzeichnung mit den Werten oben. WP-CLI: wp nxt-ai-label detect"

#: inc/class-admin.php:96
msgid "Single image: open it in the library, choose label, position and size, then Apply label."
msgstr "Einzelnes Bild: in der Mediathek öffnen, Kennzeichnung, Position und Größe wählen, dann „Kennzeichnung setzen“."

#: inc/class-admin.php:97
msgid "Several images: select them in the list and choose the bulk action Apply AI label."
msgstr "Mehrere Bilder: in der Listenansicht markieren und die Sammelaktion „KI-Kennzeichnung setzen“ wählen."

#: inc/class-admin.php:98
msgid "image with an active label."
msgid_plural "images with an active label."
msgstr[0] "Bild mit aktiver Kennzeichnung."
msgstr[1] "Bilder mit aktiver Kennzeichnung."

#: inc/class-admin.php:102
msgid "Regenerate applied labels"
msgstr "Gesetzte Kennzeichnungen neu erzeugen"

#: inc/class-admin.php:104
msgid "Rewrites labels that are already applied, using the unmarked backup. It does not add new ones. WP-CLI: wp nxt-ai-label regenerate"
msgstr "Schreibt bereits gesetzte Kennzeichnungen aus der unmarkierten Kopie neu. Setzt keine neuen. WP-CLI: wp nxt-ai-label regenerate"

#: inc/class-admin.php:116 inc/class-admin.php:234
msgid "Apply AI label"
msgstr "KI-Kennzeichnung setzen"

#: inc/class-admin.php:119
#, php-format
msgid "Only this %d image. The rest of the library stays untouched."
msgid_plural "Only these %d images. The rest of the library stays untouched."
msgstr[0] "Nur dieses %d Bild. Der Rest der Mediathek bleibt unangetastet."
msgstr[1] "Nur diese %d Bilder. Der Rest der Mediathek bleibt unangetastet."

