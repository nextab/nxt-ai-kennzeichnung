#: inc/class-admin.php:21 inc/class-admin.php:22 inc/class-admin.php:44
#: inc/class-media-fields.php:182
msgid "AI label"
msgstr "KI-Kennzeichnung"

#: inc/class-admin.php:31
msgid "You are not allowed to view this page."
msgstr "Du hast keine Berechtigung für diese Seite."

#: inc/class-admin.php:45
msgid "Only images you mark in the library are changed. Every other file stays as it is."
msgstr "Nur Bilder, die du in der Mediathek kennzeichnest, werden verändert. Alle anderen Dateien bleiben, wie sie sind."

#: inc/class-admin.php:46
msgid "Automatic when the file declares AI origin"
msgstr "Automatisch, wenn die Datei eine KI-Herkunft meldet"

#: inc/class-admin.php:47
msgid "New uploads are labeled only when the file itself contains trainedAlgorithmicMedia or compositeWithTrainedAlgorithmicMedia (IPTC Digital Source Type, often via Content Credentials). A label you remove stays removed."
msgstr "Neue Uploads werden nur gekennzeichnet, wenn die Datei selbst trainedAlgorithmicMedia oder compositeWithTrainedAlgorithmicMedia enthält (IPTC Digital Source Type, oft über Content Credentials). Eine entfernte Kennzeichnung bleibt entfernt."

#: inc/class-admin.php:48
msgid "Generators without that metadata should call nxt_ai_label_mark( $attachment_id ) after the attachment is created. The filter nxt_ai_label_attachment_is_generated runs only while automatic labeling is on."
msgstr "Erzeuger ohne diese Metadaten rufen nach dem Anlegen nxt_ai_label_mark( $attachment_id ) auf. Der Filter nxt_ai_label_attachment_is_generated läuft nur, solange die Automatik an ist."

#: inc/class-admin.php:54
msgid "New uploads"
msgstr "Neue Uploads"

#: inc/class-admin.php:56
msgid "Apply a label when the file declares an AI origin"
msgstr "Kennzeichnung setzen, wenn die Datei eine KI-Herkunft meldet"

#: inc/class-admin.php:60 inc/class-admin.php:140
#: inc/class-media-fields.php:171
msgid "Label"
msgstr "Kennzeichnung"

#: inc/class-admin.php:68 inc/class-admin.php:168
