#: inc/class-admin.php:21 inc/class-admin.php:22 inc/class-admin.php:44
#: inc/class-media-fields.php:182
msgid "AI label"
msgstr "Oznaczenie AI"

#: inc/class-admin.php:31
msgid "You are not allowed to view this page."
msgstr "Nie masz uprawnień do wyświetlenia tej strony."

#: inc/class-admin.php:45
msgid "Only images you mark in the library are changed. Every other file stays as it is."
msgstr "Zmieniane są tylko obrazy oznaczone w bibliotece mediów. Pozostałe pliki zostają bez zmian."

#: inc/class-admin.php:46
msgid "Automatic when the file declares AI origin"
msgstr "Automatycznie, gdy plik deklaruje pochodzenie AI"

#: inc/class-admin.php:47
msgid "New uploads are labeled only when the file itself contains trainedAlgorithmicMedia or compositeWithTrainedAlgorithmicMedia (IPTC Digital Source Type, often via Content Credentials). A label you remove stays removed."
msgstr "Nowe pliki są oznaczane tylko wtedy, gdy sam plik zawiera trainedAlgorithmicMedia lub compositeWithTrainedAlgorithmicMedia (IPTC Digital Source Type, często przez Content Credentials). Usunięte oznaczenie pozostaje usunięte."

#: inc/class-admin.php:48
msgid "Generators without that metadata should call nxt_ai_label_mark( $attachment_id ) after the attachment is created. The filter nxt_ai_label_attachment_is_generated runs only while automatic labeling is on."
msgstr "Generatory bez tych metadanych powinny po utworzeniu załącznika wywołać nxt_ai_label_mark( $attachment_id ). Filtr nxt_ai_label_attachment_is_generated działa tylko przy włączonym oznaczaniu automatycznym."

#: inc/class-admin.php:54
msgid "New uploads"
msgstr "Nowe pliki"

#: inc/class-admin.php:56
msgid "Apply a label when the file declares an AI origin"
msgstr "Wstaw oznaczenie, gdy plik deklaruje pochodzenie AI"

#: inc/class-admin.php:60 inc/class-admin.php:140
#: inc/class-media-fields.php:171
msgid "Label"
msgstr "Oznaczenie"

#: inc/class-admin.php:68 inc/class-admin.php:168
#: inc/class-media-fields.php:173
msgid "Position"
msgstr "Pozycja"

#: inc/class-admin.php:78 inc/class-admin.php:178
#: inc/class-media-fields.php:175
msgid "Size"
msgstr "Rozmiar"

#: inc/class-admin.php:88
msgid "Save automatic labeling"
msgstr "Zapisz oznaczanie automatyczne"

#: inc/class-admin.php:93
msgid "Scan existing images for AI origin"
msgstr "Sprawdź istniejące obrazy pod kątem pochodzenia AI"

#: inc/class-admin.php:95
msgid "Checks only images with no decision yet and writes the label using the settings above. WP-CLI: wp nxt-ai-label detect"
msgstr "Sprawdza tylko obrazy bez decyzji i zapisuje oznaczenie według ustawień powyżej. WP-CLI: wp nxt-ai-label detect"

#: inc/class-admin.php:96
msgid "Single image: open it in the library, choose label, position and size, then Apply label."
msgstr "Pojedynczy obraz: otwórz go w bibliotece, wybierz oznaczenie, pozycję i rozmiar, a następnie Zastosuj oznaczenie."

#: inc/class-admin.php:97
msgid "Several images: select them in the list and choose the bulk action Apply AI label."
msgstr "Wiele obrazów: zaznacz je na liście i wybierz działanie zbiorcze Zastosuj oznaczenie AI."

#: inc/class-admin.php:98
msgid "image with an active label."
msgid_plural "images with an active label."
msgstr[0] "obraz z aktywnym oznaczeniem."
msgstr[1] "obrazy z aktywnym oznaczeniem."
msgstr[2] "obrazów z aktywnym oznaczeniem."

#: inc/class-admin.php:102
msgid "Regenerate applied labels"
msgstr "Wygeneruj ponownie zastosowane oznaczenia"

#: inc/class-admin.php:104
msgid "Rewrites labels that are already applied, using the unmarked backup. It does not add new ones. WP-CLI: wp nxt-ai-label regenerate"
msgstr "Zapisuje od nowa już zastosowane oznaczenia z nieoznaczonej kopii. Nie dodaje nowych. WP-CLI: wp nxt-ai-label regenerate"

#: inc/class-admin.php:116 inc/class-admin.php:234
msgid "Apply AI label"
msgstr "Zastosuj oznaczenie AI"

#: inc/class-admin.php:119
#, php-format
msgid "Only this %d image. The rest of the library stays untouched."
msgid_plural "Only these %d images. The rest of the library stays untouched."
msgstr[0] "Tylko ten %d obraz. Reszta biblioteki pozostaje bez zmian."
msgstr[1] "Tylko te %d obrazy. Reszta biblioteki pozostaje bez zmian."
msgstr[2] "Tylko te %d obrazów. Reszta biblioteki pozostaje bez zmian."

