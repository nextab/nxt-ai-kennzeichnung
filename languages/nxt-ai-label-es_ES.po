msgid_plural "Only these %d images. The rest of the library stays untouched."
msgstr[0] "Solo esta %d imagen. El resto de la biblioteca permanece intacto."
msgstr[1] "Solo estas %d imágenes. El resto de la biblioteca permanece intacto."

