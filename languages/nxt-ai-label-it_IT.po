#, php-format
msgid "Only this %d image. The rest of the library stays untouched."
msgid_plural "Only these %d images. The rest of the library stays untouched."
msgstr[0] "Solo questa %d immagine. Il resto della libreria resta invariato."
msgstr[1] "Solo queste %d immagini. Il resto della libreria resta invariato."

